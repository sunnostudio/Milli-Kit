{
  "rules": {
    "millipro": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          "profile": {
            ".validate": "newData.hasChildren(['playerId'])"
          },
          "unishare": {
            "favs": { ".validate": "newData.isArray() || newData.val() == null" },
            "notif": { ".validate": true },
            "cheers": {
              "$videoId": { ".validate": true }
            }
          },
          "favorites": { ".validate": true },
          "bookmarks": { ".validate": true }
        }
      },
      "watchEvents": {
        "$pid": {
          "$videoId": {
            "$date": {
              ".read": "auth != null",
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['watchedAt'])"
            }
          }
        }
      },
      "linker": {
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name', 'ultimate'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
          "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
          "icon": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000000)" },
          "ultimate": { ".validate": "newData.isString() && newData.val().matches(/^(konomi|nono|akubi|koma|raco|yura|nuhu|tsukuri|liz|rei|mahoro|aoi|nova|uni|sona)$/)" },
          "favs": {
            ".validate": "!newData.exists() || (newData.numChildren() <= 20 && !newData.isString() && !newData.isNumber() && !newData.isBoolean())",
            "$idx": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20 && newData.val().matches(/^[a-z0-9]+$/)" }
          },
          "kamiRows": {
            ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 6)",
            "$idx": {
              ".validate": "newData.hasChildren(['url'])",
              "url": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "comment": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
              "start": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)" },
              "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
              "author": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
              "$other": { ".validate": false }
            }
          },
          "songRows": {
            ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 6)",
            "$idx": {
              ".validate": "newData.hasChildren(['url'])",
              "url": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "comment": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)" },
              "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
              "author": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
              "$other": { ".validate": false }
            }
          },
          "free": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
          "oshiHistory": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20)" },
          "oshiMark": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 10)" },
          "ogpFontJa": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
          "ogpFontEn": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200)" },
          "xUrl": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
          "sns": {
            ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 6)",
            "$idx": {
              ".validate": "newData.hasChildren(['type', 'url'])",
              "type": { ".validate": "newData.isString() && newData.val().matches(/^(x|youtube|discord|instagram|tiktok|wick|line|other)$/)" },
              "url": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
              "memo": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
              "$other": { ".validate": false }
            }
          },
          "birthday": { ".validate": "!newData.exists() || (newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)))" },
          "birthdayPublic": { ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^(hidden|monthDay|full)$/))" },
          "gallery": {
            ".validate": "!newData.exists() || (newData.hasChildren() && newData.numChildren() <= 6)",
            "$idx": {
              ".validate": "newData.hasChildren(['url'])",
              "url": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
              "comment": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 40)" },
              "$other": { ".validate": false }
            }
          },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "cards": {
        "$uid": {
          ".read": true,
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren() && newData.numChildren() <= 20"
        }
      }
    }
  }
}
